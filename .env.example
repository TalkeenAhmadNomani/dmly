# Local development only. Never commit .env files containing real credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://dmly:dmly_local_only@localhost:5432/dmly
REDIS_URL=redis://localhost:6379
AUTH_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters.
TOKEN_ENC_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Set after checking current official Meta docs; no API-version or policy default.
META_GRAPH_VERSION=
META_COMMENT_WINDOW_SECONDS=
META_MESSAGE_WINDOW_SECONDS=
META_SENDS_PER_SECOND=
SEND_ENABLED=false
